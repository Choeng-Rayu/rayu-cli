# ---- rayu-gateway environment ----
# Copy to .env for local runs. NEVER commit the real .env (provider keys).

PORT=8080

# Shared with the NestJS backend so the gateway verifies the same Rayu JWTs.
RAYU_JWT_SECRET=change-me-to-a-long-random-string

# Shared MySQL (prisma-style URL; the gateway converts it to a Go DSN).
DATABASE_URL=mysql://rayu:rayu_app_local@127.0.0.1:3306/rayu

# Redis for credit windows + top-up balance.
REDIS_URL=redis://localhost:6379

# --- Provider API key encryption ---------------------------------------------
# Provider API keys are stored in MySQL, encrypted with AES-256-GCM, and are
# decrypted by the gateway once per config refresh. This is the master key that
# opens them, and it MUST be byte-for-byte the SAME value as the backend's
# RAYU_PROVIDER_SECRET — the backend writes the envelopes, the gateway reads them.
#
#   generate:  openssl rand -base64 48        (minimum 32 characters)
#
# The gateway REFUSES TO START if provider keys exist and this is missing or
# wrong, because every hosted request would otherwise fail with no visible cause.
# ROTATION WARNING: changing this value makes every stored key undecryptable —
# they must be re-entered in the admin dashboard.
RAYU_PROVIDER_SECRET=

# --- Upstream providers -------------------------------------------------------
# NOTHING about providers lives in this file any more. Base URL, wire format,
# auth scheme, the enable switch AND the API keys themselves are all managed from
# the admin dashboard (Providers page) and stored in MySQL.
#
# Adding a provider is: create it in the dashboard, add one or more API keys to
# it, done — no restart, no deploy. Changes are picked up within
# CONFIG_REFRESH_SECONDS. Several keys per provider are rotated by priority with
# automatic failover: a 429 puts that key on a short cooldown, a 401/403 takes it
# out of rotation until an admin replaces it.

# Development ONLY: allow provider base URLs that are plain http and/or point at
# a private/loopback host (e.g. a local Ollama). Off by default because the
# provider key is sent to that URL. The backend honours the same variable when
# validating admin input.
# ALLOW_INSECURE_PROVIDER_BASE_URL=1

# Optional tuning
CONFIG_REFRESH_SECONDS=30
USER_CACHE_TTL_SECONDS=10
