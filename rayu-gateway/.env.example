# ---- rayu-gateway environment ----
# Copy to .env for local runs. NEVER commit the real .env (provider keys).

PORT=8080

# Shared with the NestJS backend so the gateway verifies the same Rayu JWTs.
RAYU_JWT_SECRET=change-me-to-a-long-random-string

# Shared MySQL (prisma-style URL; the gateway converts it to a Go DSN).
DATABASE_URL=mysql://rayu:rayu_app_local@127.0.0.1:3306/rayu

# Redis for credit windows + top-up balance.
REDIS_URL=redis://localhost:6379

# Upstream provider keys — these live ONLY in the gateway environment and are
# never exposed to the CLI or the user.
DEEPSEEK_API_KEY=
LONGCAT_API_KEY=
DEEPINFRA_API_KEY=
# Ollama Cloud — resold hosted Ollama models. The provider name is configurable
# so it can be renamed without a code change; it MUST match the BACKEND's
# OLLAMA_PROVIDER_NAME (which sets hosted_models.provider). Default 'rayu-ollama'.
OLLAMA_PROVIDER_NAME=rayu-ollama
# COMMA-SEPARATED list of keys for automatic rate-limit rotation (round-robin +
# failover on 429/402/401/403), e.g. OLLAMA_API_KEY=key1,key2,key3
OLLAMA_API_KEY=

# Add MORE upstream providers with ZERO gateway code. A ';'-separated registry of
#   name:keyEnv:auth:endpoint
#     auth     = bearer | x-api-key   (default x-api-key)
#     endpoint = anthropic ({host}/anthropic/v1/messages) | messages ({host}/v1/messages)
#                (default anthropic)
# Then set each key env var (comma-separated for rotation) and seed hosted_models
# with that provider name. Example — add OpenRouter:
#   RAYU_PROVIDERS=openrouter:OPENROUTER_API_KEY:bearer:anthropic
#   OPENROUTER_API_KEY=sk-or-...
RAYU_PROVIDERS=

# Disable providers with ZERO code: a comma-separated list of provider names
# (built-in — deepseek/longcat/deepinfra — or from RAYU_PROVIDERS) whose models
# the gateway REFUSES to route (no credit charge) and the backend HIDES from
# users. Add a name to disable, remove to re-enable. The BACKEND reads the SAME
# var, so set it in both. DeepSeek V4 is served DIRECT via DeepSeek's own
# Anthropic-compatible API (the hosted deepseek-v4-* models have
# provider=deepseek), so 'deepseek' must stay ENABLED here; only the
# not-yet-active 'longcat' is retired:
RAYU_DISABLED_PROVIDERS=longcat

# Optional tuning
CONFIG_REFRESH_SECONDS=30
USER_CACHE_TTL_SECONDS=10
