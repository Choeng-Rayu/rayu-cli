# Rayucode extension — local development environment overrides
#
# Copy this file to .env and fill in the values you want to override.
# The extension loads .env at activation and injects these vars into the
# bundled rayu engine's environment, so you can point it at a local stack
# without modifying shell profiles or launch.json.
#
# .env is excluded from the VSIX package (.vscodeignore) and from git
# (.gitignore), so it is safe to put real values here.
#
# Remove or comment out any line you want to leave at its default.

# ── Service URLs ─────────────────────────────────────────────────────────────

# rayu-backend (NestJS, default port 4000)
RAYU_API_URL=http://localhost:4000/api

# rayu-gateway (Go, default port 8080)
RAYU_GATEWAY_URL=http://localhost:8080

# rayu-web (Next.js, default port 3000) — used for the OAuth login page
RAYU_WEB_URL=http://localhost:3000

# ── Auth ─────────────────────────────────────────────────────────────────────

# Set to "false" to bypass Rayu OAuth and use direct provider API keys instead
# USE_RAYU_OAUTH=false

# ── Provider keys (direct mode, USE_RAYU_OAUTH=false) ────────────────────────

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=...
