# ---- rayu-web environment ----

# NextAuth.js (v5 beta)
# Generate NEXTAUTH_SECRET with `openssl rand -base64 32`
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Web application client)
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the browser reaches the rayu-backend API.
# Behind the reverse proxy in production this is typically https://your-domain/api
NEXT_PUBLIC_RAYU_API_URL=http://localhost:4000/api

# Where the browser reaches the rayu-gateway (credits / hosted models).
NEXT_PUBLIC_RAYU_GATEWAY_URL=http://localhost:8080

# Google Search Console HTML-tag verification token (the value after content=).
# Leave blank when verifying the domain through DNS instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- Rayu Studio (/studio) ----
# The in-browser agent ported from bolt.diy. A pure frontend: it calls
# rayu-backend for /api/studio/* and rayu-gateway for model streaming, and holds
# no third-party credentials of its own.
#
# HARD PREREQUISITE: booting WebContainer requires a StackBlitz COMMERCIAL LICENCE
# for this origin. While the flag is unset /studio returns 404 and the nav link is
# hidden, so the routes ship dark.
NEXT_PUBLIC_STUDIO_ENABLED=false

# Optional. Log verbosity inside the studio: trace|debug|info|warn|error|none.
NEXT_PUBLIC_STUDIO_LOG_LEVEL=

# Optional. Set to 'true' to stop chat history being written to IndexedDB.
NEXT_PUBLIC_STUDIO_DISABLE_PERSISTENCE=
