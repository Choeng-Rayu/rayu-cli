{
  "testEnvironment": "node",
  "roots": [
    "<rootDir>/lib",
    "<rootDir>/app/admin",
    "<rootDir>/studio"
  ],
  "testMatch": [
    "**/*.test.ts"
  ],
  "transform": {
    "^.+\\.tsx?$": "<rootDir>/jest/import-meta-transform.cjs"
  },
  "moduleNameMapper": {
    "\\.(css|scss|sass)$": "<rootDir>/jest/style-stub.cjs",
    "^~/(.*)$": "<rootDir>/studio/$1",
    "^@/(.*)$": "<rootDir>/$1"
  }
}
