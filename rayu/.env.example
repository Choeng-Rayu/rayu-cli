# Copy this file to .env (gitignored) and fill in the values.
# Bun auto-loads .env when you run `bun run build`, and scripts/build.ts bakes
# these into dist/rayu.js. Re-run the build after changing them.

# Git commit co-author email — appears in the
# "Co-Authored-By: Rayu Code <model> <email>" trailer that the CLI adds to
# commits it creates. Leave blank to use the default placeholder (noreply@rayu.dev).
RAYU_COMMIT_EMAIL=

# limited of the Open router and nvidia API key store for provider
NUMBER_API_KEYS_STORE=10

# Providers that support MULTIPLE API keys with automatic rate-limit failover.
# Built-in: nvidia, openrouter, ollama-cloud. Add MORE provider ids here
# (comma- or space-separated) to enable multi-key for them too — no code change.
# The feature stays Basic-plan gated. Example: deepseek,groq
RAYU_MULTI_KEY_PROVIDERS=
