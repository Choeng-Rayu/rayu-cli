# Copy this file to .env (gitignored) and fill in the values.
# Bun auto-loads .env when you run `bun run build`, and scripts/build.ts bakes
# these into dist/rayu.js. Re-run the build after changing them.

# Git commit co-author email — appears in the
# "Co-Authored-By: Rayu Code <model> <email>" trailer that the CLI adds to
# commits it creates. Leave blank to use the default placeholder (noreply@rayu.dev).
RAYU_COMMIT_EMAIL=
