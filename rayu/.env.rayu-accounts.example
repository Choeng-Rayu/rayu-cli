
# Enable the Rayu account login gate + /login and /logout commands.
# Set to false if you don't need to log in. Default: true.
USE_RAYU_OAUTH=true

# Route BYO-key providers through the Rayu gateway proxy (tracking + limits).
# Set to false to send requests straight to the provider. Default: true.
RAYU_ROUTE_VIA_GATEWAY=true

# If the gateway is unreachable, fall back to a DIRECT provider call (true) or
# fail closed / gateway-only (false). Default: false (fail closed / gateway-only).
RAYU_GATEWAY_CALLBACK=false

# Where the CLI reaches the Rayu backend API (must include the /api prefix).
RAYU_API_URL=http://localhost:4000/api

# Where the CLI opens the browser for the Google OAuth login bridge.
RAYU_WEB_URL=http://localhost:3000

# In production these point at your deployed site, e.g.:
# RAYU_API_URL=https://rayu.example.com/api
# RAYU_WEB_URL=https://rayu.example.com
