# ---- Rayu account login (optional, opt-in) ----
# Add these to your rayu-cli environment (.env or shell) to enable Rayu
# account login. When USE_RAYU_OAUTH is unset or false, the CLI behaves exactly
# as before — no login is required and these variables are ignored.

# Enable the Rayu account login gate + /login and /logout commands.
USE_RAYU_OAUTH=false

# Where the CLI reaches the Rayu backend API (must include the /api prefix).
RAYU_API_URL=http://localhost:4000/api

# Where the CLI opens the browser for the Clerk login bridge.
RAYU_WEB_URL=http://localhost:3000

# In production these point at your deployed site, e.g.:
# RAYU_API_URL=https://rayu.example.com/api
# RAYU_WEB_URL=https://rayu.example.com
