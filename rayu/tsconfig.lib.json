{
  // Declaration emit for the library surface the Rayucode extension imports.
  //
  // Extends the typecheck config so the declarations are generated under exactly
  // the same compiler options the project is checked with — including
  // `noImplicitAny: false`, which the committed React-Compiler output requires,
  // and the `react/compiler-runtime` path stub.
  //
  // Scoped to `src` (not `scripts`/`test` like tsconfig.typecheck.json) for two
  // reasons: `rootDir` then resolves to `src`, so the entry lands at the stable
  // path `dist/types/entrypoints/library.d.ts` that package.json `exports`
  // points at; and the CLI's build scripts and test suite have no business in a
  // published type tree.
  //
  // `bun run build:lib` invokes this. Type ERRORS are not gated here — the
  // project carries an accepted baseline of them (see scripts/typecheck-baseline.ts)
  // and `tsc` still emits, since emit is only withheld under `noEmitOnError`.
  "extends": "./tsconfig.typecheck.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist/types"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "globals.d.ts"],
  "exclude": ["node_modules", "dist", "un-use-code"]
}
