// Rayu accounts schema. Enum-like fields are modeled as String (validated at
// the API layer via class-validator) to keep DTO/types simple and decoupled
// from generated enums. Table/column names match the original schema.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  clerkUserId  String    @unique @db.VarChar(191)
  email        String?   @db.VarChar(320)
  displayName  String?   @db.VarChar(191)
  avatarUrl    String?   @db.VarChar(1024)
  role         String    @default("user") @db.VarChar(32)
  status       String    @default("active") @db.VarChar(32)
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime?

  subscriptions Subscription[]
  payments      Payment[]
  feedback      Feedback[]
  usageEvents   UsageEvent[]

  @@map("users")
}

model Plan {
  id           Int     @id @default(autoincrement())
  code         String  @unique @db.VarChar(32)
  name         String  @db.VarChar(191)
  priceCents   Int     @default(0)
  availability String  @default("coming_soon") @db.VarChar(32)
  limits       Json?

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  planId           Int       @map("plan_id")
  status           String    @default("active") @db.VarChar(32)
  startedAt        DateTime  @default(now())
  currentPeriodEnd DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@map("subscriptions")
}

model Payment {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  provider    String   @default("bakong") @db.VarChar(64)
  amountCents Int      @default(0)
  currency    String   @default("USD") @db.VarChar(8)
  status      String   @default("pending") @db.VarChar(32)
  externalRef String?  @db.VarChar(191)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String   @default("other") @db.VarChar(32)
  message   String   @db.Text
  rating    Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("feedback")
}

model UsageEvent {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  provider  String   @db.VarChar(64)
  model     String?  @db.VarChar(128)
  source    String   @default("cli") @db.VarChar(32)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@map("usage_events")
}
