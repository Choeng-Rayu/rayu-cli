# ---- rayu-backend environment ----
# Server
PORT=4000
NODE_ENV=production
# Origin of the website (for CORS)
# Local dev:  http://localhost:3000
# Production: https://rayucode.com
WEB_ORIGIN=http://localhost:3000

# ---- Database (MySQL, used by Prisma) ----
# Prisma reads DATABASE_URL directly (prisma/schema.prisma).
DATABASE_URL=mysql://rayu:rayu@mysql:3306/rayu

# ---- OAuth (Google) ----
# Used to validate Google ID tokens issued to your frontend.
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# ---- Rayu session JWT ----
# Generate a strong random value, e.g. `openssl rand -hex 32`
RAYU_JWT_SECRET=change-me-to-a-long-random-string

# Encrypts provider API keys (AES-256-GCM) before they are stored in MySQL.
# The GATEWAY must be given the SAME value so it can decrypt them.
#   generate:  openssl rand -base64 48        (minimum 32 characters)
# ROTATION WARNING: changing this makes every stored provider key undecryptable —
# each one must be re-entered in the admin dashboard.
# ALSO encrypts each user's third-party Studio tokens (GitHub/GitLab/Netlify/
# Vercel/Supabase) in `studio_connections`, so rotating it additionally forces
# every user to reconnect those services in Studio settings.
RAYU_PROVIDER_SECRET=
RAYU_ACCESS_TTL=3600
RAYU_REFRESH_TTL=2592000

# ---- Bakong (PHASE 2 — payments not implemented yet) ----
# NOTE: keep these server-side only. Rotate any token that was shared in chat.
BAKONG_MERCHANT_ID=
BAKONG_PHONE_NUMBER=
BAKONG_DEVELOPER_TOKEN=
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1

# ---- ABA payments (fixed-amount KHQR + Telegram credit-alert confirmation) ----
# Your STATIC ABA merchant KHQR string (POI = 11, no amount). From ABA Business
# app -> My QR. The backend turns it into a dynamic amount-bearing QR per charge.
ABA_STATIC_QR=
# The Telegram group/channel ABA posts credit alerts into (Bot-API marked form,
# e.g. -1004302307901). The listener normalizes the -100 prefix.
ABA_TELEGRAM_GROUP_ID=

# ---- Stripe (card rail — the 3rd payment rail alongside ABA / Bakong KHQR) ----
# All values are env-only (never the database). The rail is GATED on STRIPE_ENABLED:
# while off (or unset) every card endpoint answers 501 and the web clients hide
# the "Pay with card" button, so a deployment without a Stripe account keeps
# working exactly as before. No publishable key is needed — the hosted Checkout
# page is server-side only.
STRIPE_ENABLED=false
# Server-side secret key (sk_live_... or sk_test_...). Pinned to apiVersion below
# so a Stripe-side version roll does not silently change the wire format under us.
STRIPE_SECRET_KEY=
# Signing secret from the Stripe Dashboard webhook endpoint (whsec_...). Used to
# verify every webhook's signature against the RAW request body.
STRIPE_WEBHOOK_SECRET=
# Seconds of clock skew allowed when verifying a webhook signature. Stripe's
# default is 300. MUST be > 0 — 0 disables the replay check (a captured payload
# could be replayed indefinitely). Leave unset to use the 300s default.
STRIPE_WEBHOOK_TOLERANCE=300
# Where Stripe returns the buyer after a completed Checkout Session. Use a
# placeholder Stripe supports: {CHECKOUT_SESSION_ID}. The page should poll
# GET /api/payments/:id/status (the paymentId is stashed in sessionStorage before
# the redirect) — a redirect is NOT proof of payment.
#   Example: https://rayucode.com/billing?session_id={CHECKOUT_SESSION_ID}
STRIPE_SUCCESS_URL=http://localhost:3000/billing
# Where Stripe returns the buyer if they abandon Checkout. Same site, different
# page, so the user lands back in the purchase flow rather than on Stripe.
STRIPE_CANCEL_URL=http://localhost:3000/billing
# Pinned Stripe API version (never null = "account default", which would silently
# change the wire format when Stripe rolls a version). Bump deliberately, with a
# migration test against every event type Rayu subscribes to.
STRIPE_API_VERSION=2026-07-29.dahlia

# Local testing: forward Stripe events to the local backend.
#   stripe listen --forward-to localhost:4000/api/payments/stripe/webhook
# Secret rotation: rotate the webhook secret with DELAYED-EXPIRY so the old secret
# still validates in-flight events during the cutover. Set the new
# STRIPE_WEBHOOK_SECRET, restart the backend, then remove the old secret from the
# Stripe Dashboard. The Stripe SDK retries idempotent failures itself, so a
# brief overlap window is safe.

# ABA is confirmed by reading ABA's bot credit alert in the group above. The Bot
# API can't read another bot's messages, so we use a real Telegram USER account
# via MTProto (GramJS). api_id + api_hash from https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generated once by `npm run telegram:login`. Grants full account access —
# keep secret, never commit. The account must be a MEMBER of the group above.
TELEGRAM_SESSION=

# ---- Shared Telegram bot (drives the CLI for ALL users on ONE bot) ----------
# Token from @BotFather for the SINGLE bot Rayu hosts so users don't need their
# own bot (e.g. @rayu_clawbot). When set, the backend runs one getUpdates poller
# and routes each linked chat's messages to the owning user (see the `telegram`
# module). Leave BLANK to disable the shared bot (users then bring their own
# token in the CLI). Its OWN var name so it never collides with the ABA payment
# bot's TELEGRAM_BOT_TOKEN (a different bot, handled separately above).
RAYU_SHARED_BOT_TOKEN=
# Webhook mode (recommended for production / multiple backend instances):
# Telegram POSTs updates to this public HTTPS URL. Must include the /api prefix.
# Example: https://rayucode.com/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Optional secret token Telegram includes in X-Telegram-Bot-Api-Secret-Token.
# Strongly recommended in production.
TELEGRAM_WEBHOOK_SECRET=
# Set to 'true' to keep the shared bot endpoints available but NOT start the
# central poller (e.g. on a second backend instance — only one may poll a token).
# Ignored when TELEGRAM_WEBHOOK_URL is set.
SKIP_TELEGRAM_POLL=

# ---- Rayu Studio (/api/studio/*) --------------------------------------------
# The Studio frontend lives in rayu-web and is gated there by
# NEXT_PUBLIC_STUDIO_ENABLED. Nothing here enables or disables it: these routes
# are always mounted and always require a Rayu JWT (RayuAuthGuard), so an
# unauthenticated caller gets 401 regardless.
#
# Extra git hosts the Studio git proxy may reach, comma-separated (e.g. a company
# GitLab). Leave BLANK for the built-in allow-list only: github.com,
# gist.github.com, codeload.github.com, api.github.com, gitlab.com,
# bitbucket.org, git.sr.ht.
#
# WHY AN ALLOW-LIST: /api/studio/git-proxy/* fetches a URL derived from the
# browser's request. Without the list it is an SSRF pivot into the private
# network. Hosts added here are STILL rejected if they resolve to a private,
# loopback, or cloud-metadata address, so this cannot be used to reach localhost.
# See src/common/studio-urls.ts.
STUDIO_GIT_PROXY_EXTRA_HOSTS=
