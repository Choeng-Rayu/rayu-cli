{
  "name": "rayu-backend",
  "version": "0.1.0",
  "description": "Rayu accounts backend — NestJS API (auth, plans, usage, feedback, admin)",
  "license": "UNLICENSED",
  "private": true,
  "prisma": {
    "seed": "ts-node src/seed.ts"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "seed": "ts-node src/seed.ts",
    "telegram:login": "ts-node scripts/telegram-login.ts",
    "keys:backfill": "ts-node scripts/backfill-provider-keys.ts",
    "test": "jest --config jest.config.json",
    "test:e2e": "prisma generate && jest --config test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.1.0",
    "bakong-khqr": "^1.0.20",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "prisma": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
