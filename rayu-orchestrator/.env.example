# rayu-orchestrator configuration.
# Required keys have no default and fail fast on missing/malformed values.
# Optional keys show their default in a comment.

# --- HTTP server ---
# PORT=9090                       # optional (default 9090)

# --- Routing / reverse proxy (Req 14) ---
BASE_DOMAIN=apps.example.com      # required; wildcard app domain (prod) or sslip.io base (dev)
# PLATFORM_HOST=rayu.example.com  # optional; existing platform host for the edge proxy's static routers
# DNS_PROVIDER=                   # optional; DNS-01 provider id for wildcard TLS

# --- Container runtime + networks (Req 5, 12, 14) ---
# DOCKER_HOST=                    # optional; empty = Docker SDK default/socket
# BUILDS_DIR=/srv/builds          # optional (default /srv/builds)
# PROXY_NETWORK=proxy             # optional (default proxy)
# EGRESS_NETWORK=egress           # optional (default egress)

# --- Admission control + quotas (Req 3, 17) ---
MAX_CONCURRENT_BUILDS=4           # required; global cap on concurrently building sandboxes
PER_USER_CONCURRENCY=2            # required; per-user Concurrency_Quota
PER_USER_DAILY=10                 # required; per-user Daily_Quota (trailing 24h)

# --- Sandbox image + resource limits (Req 4, 5.6) ---
SANDBOX_IMAGE=rayu/sandbox:pinned # required
SANDBOX_CPU=1.5                   # required; CPU count (e.g. 1, 1.5)
SANDBOX_MEM=512m                  # required; memory size (b/k/m/g)
SANDBOX_PIDS=256                  # required; max process (pids) limit

# --- Swarm invocation (Req 6.2) ---
BUILD_MODEL=claude-sonnet         # required; model passed to rayu-cli --model

# --- Timeouts / tuning (Req 7.5, 12.5, 13.1, 19.2) ---
BUILD_TIMEOUT=20m                 # required; max time in the building status
HEALTHCHECK_DEADLINE=60s          # required; deploy health-check deadline
APP_TTL=24h                       # required; max App_Container lifetime
APP_IDLE_TTL=30m                  # required; idle (last-access) reap threshold
# DEPLOY_COALESCE_INTERVAL=2s     # optional (default 2s)

# --- Persistence (Req 9, 16) ---
# STORE_DSN=memory://             # optional (default memory://); MySQL DSN wired in a later task

# --- Service auth + rate limiting (Req 15) ---
SERVICE_AUTH_SECRET=change-me     # required; shared with rayu-backend/gateway (RAYU_JWT_SECRET)
# RATE_LIMIT_RPS=20               # optional (default 20); per-Caller rate limit

# --- Redaction (Req 18.3, 21.4) ---
# SECRET_PATTERNS=sk-[A-Za-z0-9]+,ghp_[A-Za-z0-9]+   # optional; comma-separated regexes
