# ---- deploy/.env (used by docker-compose) ----
# Copy to .env and fill in. NEVER commit the real .env.
#
# TWO TOPOLOGIES, ONE FILE OF SECRETS:
#   docker-compose.yml          plain Docker host; Caddy terminates TLS on 80/443
#                               and routes /api and /gateway under ONE domain.
#   docker-compose.coolify.yml  Coolify; its proxy terminates TLS and each service
#                               gets its own subdomain. See
#                               documentations/deploy-coolify.md
# The Coolify file additionally needs PUBLIC_API_URL + PUBLIC_GATEWAY_URL below.

# Public site. SITE_ADDRESS controls Caddy/TLS (single-VPS file only):
#   - a hostname like rayucode.com  -> automatic HTTPS
#   - ":80"                        -> local HTTP only (no TLS)
SITE_ADDRESS=rayucode.com
# Full public URL used for CORS + the browser's API base.
PUBLIC_SITE_URL=https://rayucode.com

# ---- Coolify topology only: where the browser and the CLI reach each service ----
# On the single-VPS file these are derived from PUBLIC_SITE_URL (/api, /gateway) and
# can be left as-is. Note the /api suffix: the backend serves under that prefix.
PUBLIC_API_URL=https://api.rayucode.com/api
PUBLIC_GATEWAY_URL=https://gateway.rayucode.com

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=rayu
MYSQL_USER=rayu
MYSQL_PASSWORD=change-me-app

# ---- NextAuth.js (frontend session) ----
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=https://rayucode.com

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Rayu session JWT (openssl rand -hex 32) ----
RAYU_JWT_SECRET=change-me-to-a-long-random-string

# ---- Bakong (PHASE 2 — not used yet; keep blank or rotate any shared token) ----
BAKONG_MERCHANT_ID=
BAKONG_PHONE_NUMBER=
BAKONG_DEVELOPER_TOKEN=
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1

# ---- Hosted catalog ownership ----
# The hosted catalog (providers + models) is ADMIN-OWNED: the backend does NOT
# seed it. A fresh deployment therefore starts EMPTY — the CLI offers no hosted
# models until an admin adds a provider and a model in the dashboard, and a
# restart never re-creates defaults you removed.
# Set to true ONLY to populate the shipped example providers/models on a brand-new
# database. Plans and global settings seed regardless.
SEED_CATALOG=

# ---- Provider API key encryption (backend + gateway share this) ----
# Provider API keys are entered in the admin dashboard and stored in MySQL,
# encrypted with AES-256-GCM. This is the master key: the backend seals keys with
# it, the gateway opens them. BOTH services must see the SAME value.
#
#   generate:  openssl rand -base64 48        (minimum 32 characters)
#
# The gateway refuses to start if keys exist and this is missing/wrong.
# ROTATION WARNING: changing it makes every stored provider key undecryptable —
# each one has to be re-entered in the dashboard.
RAYU_PROVIDER_SECRET=

# ---- Upstream providers: nothing to configure here ----
# Base URL, wire format (Anthropic Messages / OpenAI compatible / OpenAI
# Responses / Google GenAI), auth scheme, the enable switch AND the API keys are
# all rows in MySQL, managed from the admin dashboard → Providers. Adding a
# provider or rotating a key needs no redeploy (picked up within ~30s), and a
# provider can hold several keys, rotated with automatic failover.

# ---- Shared Telegram bot (backend serves ALL users on ONE bot) ----
# Token from @BotFather (e.g. @rayu_clawbot). When set, the backend runs a single
# central poller and routes each linked chat to the owning Rayu user, so CLI
# users don't need their own bot (they can still bring one). Leave blank to
# disable. Its OWN var name so it doesn't collide with a payment bot's token.
RAYU_SHARED_BOT_TOKEN=

# ---- Gateway tuning (optional; safe defaults when blank) ----
# CONFIG_REFRESH_SECONDS   SAFETY NET for picking up a provider/model/key edit
#                          (default 30). Normally the dashboard notifies the
#                          gateway on save, so edits are live immediately; this
#                          timer only covers a missed notification.
# RAYU_CONFIG_CHANNEL      Redis pub/sub channel used to relay an admin change to
#                          other gateway replicas (blank = rayu:config-changed).
# RAYU_MAX_INFLIGHT        global cap on concurrent hosted streams (blank = unlimited).
# RAYU_ENFORCE_MODEL_FIDELITY=1  hard-reject a /v1/proxy request whose intended
#                          model family differs from the routed model (default: log only).
# RAYU_PROXY_BODY_READ_TIMEOUT=N  seconds to wait for a /v1/proxy request body
#                          before 408 (blank = Go default; no SSE-breaking cap).
CONFIG_REFRESH_SECONDS=30
RAYU_CONFIG_CHANNEL=
RAYU_MAX_INFLIGHT=
RAYU_ENFORCE_MODEL_FIDELITY=
RAYU_PROXY_BODY_READ_TIMEOUT=

# ---- Rayu Studio (rayucode.com/studio) ----
# The in-browser agent ported from bolt.diy. Runs entirely in the frontend and
# talks to rayu-backend (/api/studio/*) and rayu-gateway (LLM streaming).
#
# HARD PREREQUISITE: the studio boots StackBlitz WebContainer, which requires a
# COMMERCIAL LICENCE for this origin. Leave the flag off until that is in place —
# /studio 404s while it is unset, so the routes ship dark by default.
#
# NEXT_PUBLIC_STUDIO_ENABLED must be a BUILD-TIME value: Next inlines
# NEXT_PUBLIC_* at build, so it is passed as a docker build arg, not only as a
# runtime env var.
NEXT_PUBLIC_STUDIO_ENABLED=false

# Extra git hosts the studio's git proxy may fetch from, comma separated (e.g. a
# self-hosted GitLab). github.com, gitlab.com and bitbucket.org are always
# allowed. Entries are still refused if they resolve to a private address, so
# this cannot be used to reach internal services.
STUDIO_GIT_PROXY_EXTRA_HOSTS=

# Optional studio frontend tuning:
# NEXT_PUBLIC_STUDIO_LOG_LEVEL           trace|debug|info|warn|error|none (blank = info)
# NEXT_PUBLIC_STUDIO_DISABLE_PERSISTENCE 'true' stops chat history being written to IndexedDB
NEXT_PUBLIC_STUDIO_LOG_LEVEL=
NEXT_PUBLIC_STUDIO_DISABLE_PERSISTENCE=
