# ---- deploy/.env (used by docker-compose) ----
# Copy to .env and fill in. NEVER commit the real .env.

# Public site. SITE_ADDRESS controls Caddy/TLS:
#   - a hostname like rayucode.com  -> automatic HTTPS
#   - ":80"                        -> local HTTP only (no TLS)
SITE_ADDRESS=rayucode.com
# Full public URL used for CORS + the browser's API base.
PUBLIC_SITE_URL=https://rayucode.com

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=rayu
MYSQL_USER=rayu
MYSQL_PASSWORD=change-me-app

# ---- NextAuth.js (frontend session) ----
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=https://rayucode.com

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Rayu session JWT (openssl rand -hex 32) ----
RAYU_JWT_SECRET=change-me-to-a-long-random-string

# ---- Bakong (PHASE 2 — not used yet; keep blank or rotate any shared token) ----
BAKONG_MERCHANT_ID=
BAKONG_PHONE_NUMBER=
BAKONG_DEVELOPER_TOKEN=
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1

# ---- Hosted catalog ownership ----
# The hosted catalog (providers + models) is ADMIN-OWNED: the backend does NOT
# seed it. A fresh deployment therefore starts EMPTY — the CLI offers no hosted
# models until an admin adds a provider and a model in the dashboard, and a
# restart never re-creates defaults you removed.
# Set to true ONLY to populate the shipped example providers/models on a brand-new
# database. Plans and global settings seed regardless.
SEED_CATALOG=

# ---- Provider API key encryption (backend + gateway share this) ----
# Provider API keys are entered in the admin dashboard and stored in MySQL,
# encrypted with AES-256-GCM. This is the master key: the backend seals keys with
# it, the gateway opens them. BOTH services must see the SAME value.
#
#   generate:  openssl rand -base64 48        (minimum 32 characters)
#
# The gateway refuses to start if keys exist and this is missing/wrong.
# ROTATION WARNING: changing it makes every stored provider key undecryptable —
# each one has to be re-entered in the dashboard.
RAYU_PROVIDER_SECRET=

# ---- Upstream providers: nothing to configure here ----
# Base URL, wire format (Anthropic Messages / OpenAI compatible / OpenAI
# Responses / Google GenAI), auth scheme, the enable switch AND the API keys are
# all rows in MySQL, managed from the admin dashboard → Providers. Adding a
# provider or rotating a key needs no redeploy (picked up within ~30s), and a
# provider can hold several keys, rotated with automatic failover.

# ---- Shared Telegram bot (backend serves ALL users on ONE bot) ----
# Token from @BotFather (e.g. @rayu_clawbot). When set, the backend runs a single
# central poller and routes each linked chat to the owning Rayu user, so CLI
# users don't need their own bot (they can still bring one). Leave blank to
# disable. Its OWN var name so it doesn't collide with a payment bot's token.
RAYU_SHARED_BOT_TOKEN=
